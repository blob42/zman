#!/usr/bin/env bash
# zman: interactive fzf man-pages browser
set -e

sections=""
FZF_MAN_SECTIONS_SCRIPT=~/scripts/fzf/fzf_zman_sections
OFS="$IFS"
CHAT_MODEL="gemma4-moe:it"
TEMP=0.4
MAX_TOKENS=30
OAI_API=http://llama.swap:8080/v1
HEADERS="-H 'Content-Type: application/json'"

# @flag -g --gen Generate man keywords
# @flag -d --debug
# @option -s --sections
# @arg query*

usage(){
    echo "Usage: $0 [-h] [-v] [-s section[,section ...]]"
    echo "  -h, --help     Show help and exit"
    echo "  -s, --section  Specify comma separated list of man page sections"
}

error(){
  echo "error message $1"
  dunstify -u critical $1
  exit 40
}


ai_gen_keywords(){
    read -p "ai-man topic: " -r input_query
    command -v yq >/dev/null || errquit 'missing yq'

    data="$(yq -oj <<EOF
    model: $CHAT_MODEL
    temperature: $TEMP
    max_tokens: $MAX_TOKENS
    grammar: |
        root ::= keyword ( "|" keyword )*
        keyword ::= [a-zA-Z0-9-]+
    messages:
        - role: system
          content: |
            You are an AI manpage keyword generator. Your task is to transform user input into a list of precise keywords for Linux man-page searches.

            Given a query:
            0. Assume the role of an expert in the context domain (e.g., "file system" → file system administrator).
            1. Tokenize input into words.
            2. Generate *only technical synonyms* relevant to Linux (e.g., for "disk", use "disk", "hdd", "storage" but NOT generic terms like "drive").
            3. For each word, create a synonym list using domain-specific vocabulary (e.g., for "network", include "ip", "tcp", "socket").
            4. Filter out:
               - Generic English words (e.g., 'the', 'and', 'system', 'process')
               - Stopwords (e.g., 'how', 'to')
               - Special characters (except hyphens in technical terms like "apt-get")
            5. Remove duplicate stems (e.g., "read", "reading" → keep only "read").

            ## OUTPUT FORMAT:
            - Return a pipe-separated list of 5 to 10 keywords: keyword|keyword|...
            - Keywords must be Linux-specific technical terms (e.g., use 'printf' not 'print').
            - NO explanations or notes. Only the keyword list.

            Example:
            Input: "how to read files"
            Output: open|fopen|read|file|files|scanf
        - role: user
          content: $input_query

EOF
)"
    curl -skL $HRADERS --json "$data" $OAI_API/chat/completions
}


eval "$(argc --argc-eval "$0" "$@")"

if [[ "$argc_debug" -eq 1 ]]; then
     echo gen: $argc_gen
     echo sections: ${argc_sections[@]}
     echo query: ${argc_query[@]}
fi
# exit 0


query="${argc_query[@]}"
sections="$argc_sections"
prompt="($query)> "

if [[ "$argc_gen" -eq 1 ]]; then
    query="$(ai_gen_keywords | yq '.choices[0].message.content')"
    query=$(echo -n "$query" | sed -E "s/(\w+) (\w+)/'\1 \2'/g")
    prompt="(ai)> "

    if [[ "$argc_debug" -eq 1 ]]; then
        echo "$query"
        exit 0
    fi
fi


if [[ $query =~ "|" ]];then
    prompt="(ai)> "
fi


pre_query=""
if [ -n "$sections" ]; then
    pre_query="-S $sections"
fi

if [ -z "$query" ]; then
    query="."
fi

#query="dlopen|dlsym|dlclose|dynamic linking|shared library|loadlibrary|rt_mutex|rt_thread"
# echo "query: $query"
# --preview "echo topic={1} section=\$(echo {2} | tr -d '()')" \

# disable IFS for regex queries gives narrower results
# this is only done for the initial result from ai, after calling fzf_zman_sections
# IFS should not be cleared
# if [[ $query =~ "ai:" ]];then
    # IFS=''
#     query="${query#ai:}"
#     echo zman: $query >> /tmp/zman_debug
# fi
fzf_sections_args="\"$query\" \$FZF_PROMPT \$FZF_QUERY"
 man $pre_query -k $query | fzf --header-first --prompt="$prompt" \
    --preview "man \$(echo {2} | tr -d '()') {1} 2>/dev/null | col -bx | bat -l man -p --color always" \
    --bind "alt-enter:reload-sync(man $pre_query -k {q})+transform-prompt(printf '(%s)> ' \$FZF_QUERY)+clear-query" \
    --bind "alt-a:become(zman -g)" \
    --bind "ctrl-s:become($FZF_MAN_SECTIONS_SCRIPT $fzf_sections_args)" \
    --bind "enter:become(echo {} | tr -d '()' | awk '{printf \"%s \", \$2} {print \$1}' | xargs -r man)" \
    --header 'A-Ent: update query. C-s: sections: A-a: AI.  Ent: Choose.'
